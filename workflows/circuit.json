{
  "$schema": "../../packages/loader/schema.json",
  "inputs": {
    "name": "marina-bay",
    "weather": "night",
    "quality": "4k"
  },
  "steps": [
    {
      "id": "physics",
      "type": "asset",
      "loader": "gltf",
      "dependsOn": [],
      "source": {
        "kind": "static",
        "path": "/assets/{{inputs.name}}/physics.glb"
      }
    },
    {
      "id": "layout",
      "type": "asset",
      "loader": "gltf",
      "dependsOn": [],
      "source": {
        "kind": "static",
        "path": "/assets/{{inputs.name}}/layout.glb"
      }
    },
    {
      "id": "graphics",
      "type": "asset",
      "loader": "gltf",
      "dependsOn": [],
      "source": {
        "kind": "static",
        "path": "/assets/{{inputs.name}}/graphics.gltf"
      }
    },
    {
      "id": "sky",
      "type": "asset",
      "loader": "hdr",
      "source": {
        "kind": "static",
        "path": "/assets/hdrs/{{inputs.weather}}/{{inputs.quality}}.hdr"
      }
    },
    {
      "id": "racingLine",
      "type": "data",
      "source": {
        "kind": "rest",
        "url": "/assets/{{inputs.name}}/racing-line.json"
      }
    },
    {
      "id": "lighting",
      "type": "data",
      "source": {
        "kind": "rest",
        "url": "/assets/{{inputs.name}}/lighting.json"
      }
    },
    {
      "id": "drsZones",
      "type": "data",
      "source": {
        "kind": "rest",
        "url": "/assets/{{inputs.name}}/drs-zones.json"
      }
    },
    {
      "id": "sections",
      "type": "data",
      "source": {
        "kind": "rest",
        "url": "/assets/{{inputs.name}}/sections.json"
      }
    },
    {
      "id": "downsampleFactor",
      "type": "data",
      "source": {
        "kind": "static",
        "data": 8
      }
    }
  ]
}
