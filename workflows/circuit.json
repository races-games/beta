{
  "$schema": "../../packages/data-loaders/schema.json",
  "inputs": {
    "name": "nurburgring"
  },
  "steps": [
    {
      "id": "graphics",
      "type": "asset",
      "loader": "gltf",
      "source": {
        "kind": "static",
        "path": "/assets/circuits/{{inputs.name}}/graphics.glb"
      }
    },
    {
      "id": "physics",
      "type": "asset",
      "loader": "gltf",
      "source": {
        "kind": "static",
        "path": "/assets/circuits/{{inputs.name}}/physics.glb"
      }
    },
    {
      "id": "racingLine",
      "type": "data",
      "source": {
        "kind": "rest",
        "url": "/assets/circuits/{{inputs.name}}/curves.json"
      }
    }
  ]
}